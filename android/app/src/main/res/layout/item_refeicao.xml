<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_ranking_row">
    <TextView android:id="@+id/resumoRefeicao" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ranking_accent" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/descricaoRefeicao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/white" android:textSize="16sp" />
    <TextView android:id="@+id/observacaoRefeicao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ranking_text_secondary" android:textSize="14sp" />
    <TextView android:id="@+id/alimentosRefeicao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/ranking_text_secondary" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end">
        <Button android:id="@+id/editarRefeicao" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/diario_edit" />
        <Button android:id="@+id/excluirRefeicao" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/diario_delete" />
    </LinearLayout>
</LinearLayout>
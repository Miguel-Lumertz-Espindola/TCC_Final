<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/ranking_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:id="@+id/etapaTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/ranking_accent" android:accessibilityLiveRegion="polite" android:text="Criar conta" />
<LinearLayout android:id="@+id/etapa0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Nome"><com.google.android.material.textfield.TextInputEditText android:id="@+id/nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLength="100" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="E-mail"><com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLength="254" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Senha (mínimo 8 caracteres)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/senha" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="255" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Confirmar senha"><com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLength="255" /></com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<LinearLayout android:id="@+id/etapa1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Nascimento (dd/mm/aaaa)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/nascimento" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" android:maxLength="10" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Altura (cm)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/altura" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLength="6" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Peso atual (kg)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/peso" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLength="6" /></com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<LinearLayout android:id="@+id/etapa2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Objetivo" android:labelFor="@+id/objetivo" />
<Spinner style="@style/Widget.Tcc_final.Cadastro.Seletor" android:id="@id/objetivo" android:layout_width="match_parent" android:layout_height="56dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Nível de atividade física" android:labelFor="@+id/atividade" />
<Spinner style="@style/Widget.Tcc_final.Cadastro.Seletor" android:id="@id/atividade" android:layout_width="match_parent" android:layout_height="56dp" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/cadastro_praticidade" android:labelFor="@+id/praticidade" />
<Spinner style="@style/Widget.Tcc_final.Cadastro.Seletor" android:id="@id/praticidade" android:layout_width="match_parent" android:layout_height="56dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/cadastro_rigor" android:labelFor="@+id/rigor" />
<Spinner style="@style/Widget.Tcc_final.Cadastro.Seletor" android:id="@id/rigor" android:layout_width="match_parent" android:layout_height="56dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/cadastro_orcamento" android:labelFor="@+id/orcamento" />
<Spinner style="@style/Widget.Tcc_final.Cadastro.Seletor" android:id="@id/orcamento" android:layout_width="match_parent" android:layout_height="56dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/cadastro_tags_titulo" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/cadastro_tags_ajuda" />
<com.google.android.material.chip.ChipGroup android:id="@+id/tagsAlimentares" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:singleSelection="false" app:selectionRequired="false">
    <com.google.android.material.chip.Chip android:id="@+id/tagSemLactose" style="@style/Widget.Tcc_final.Cadastro.Tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tag_sem_lactose" android:checkable="true" />
    <com.google.android.material.chip.Chip android:id="@+id/tagSemGluten" style="@style/Widget.Tcc_final.Cadastro.Tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tag_sem_gluten" android:checkable="true" />
    <com.google.android.material.chip.Chip android:id="@+id/tagVegetariano" style="@style/Widget.Tcc_final.Cadastro.Tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tag_vegetariano" android:checkable="true" />
    <com.google.android.material.chip.Chip android:id="@+id/tagVegano" style="@style/Widget.Tcc_final.Cadastro.Tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tag_vegano" android:checkable="true" />
</com.google.android.material.chip.ChipGroup>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cadastro_tags_lactose" android:textSize="12sp" />
</LinearLayout>
<Button android:id="@+id/continuar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Continuar" />
<Button style="@style/Widget.Tcc_final.Cadastro.BotaoSecundario" android:id="@+id/anterior" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Etapa anterior" />
<Button style="@style/Widget.Tcc_final.Cadastro.BotaoTexto" android:id="@+id/voltarLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Já tenho uma conta" />
</LinearLayout>
</ScrollView>

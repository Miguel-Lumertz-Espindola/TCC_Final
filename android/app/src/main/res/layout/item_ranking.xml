<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutLinha" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="76dp" android:orientation="horizontal" android:padding="12dp"
    android:gravity="center_vertical" android:layout_marginBottom="8dp" android:background="@drawable/bg_ranking_row">
    <TextView android:id="@+id/txtPosicao" android:layout_width="48dp" android:layout_height="wrap_content"
        android:textSize="18sp" android:textStyle="bold" android:textColor="@color/ranking_accent" />
    <ImageView android:id="@+id/imgMascoteRanking" android:layout_width="32dp" android:layout_height="32dp"
        android:src="@drawable/ic_character_shield_24" android:tint="@color/ranking_text_secondary"
        android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
    <TextView android:id="@+id/txtNomeJogador" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="16sp" android:textColor="@color/ranking_text"
        android:maxLines="2" android:ellipsize="end" android:layout_marginEnd="8dp" />
    <TextView android:id="@+id/txtPontosJogador" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ranking_accent" />
</LinearLayout>
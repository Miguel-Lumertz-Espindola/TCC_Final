<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_precisao_intro" android:textSize="14sp"
            android:textColor="@color/ranking_text_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/home_precisao_exata"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:id="@+id/precisaoExataHorarios" android:text="@string/home_horarios_carregando"
            android:textSize="14sp" android:textColor="@color/ranking_text_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/home_precisao_parcial"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:id="@+id/precisaoParcialHorarios" android:text="@string/home_horarios_carregando"
            android:textSize="14sp" android:textColor="@color/ranking_text_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/home_precisao_imprecisa"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/home_precisao_imprecisa_horario"
            android:textSize="14sp" android:textColor="@color/ranking_text_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:id="@+id/horarioReferenciaCheckin" android:text="@string/home_horarios_carregando" android:accessibilityLiveRegion="polite"
            android:textSize="14sp" android:textColor="@color/ranking_text_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/home_checkin_explicacao"
            android:textSize="14sp" android:textColor="@color/ranking_text_secondary" />
    </LinearLayout>
</ScrollView>

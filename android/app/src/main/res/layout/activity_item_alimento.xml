<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="#1A1A1A"
    android:gravity="center_vertical">

    <!-- Imagem do Alimento -->
    <ImageView
        android:id="@+id/imgAlimento"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_launcher_foreground"
        android:scaleType="centerCrop" />

    <!-- Textos: Nome e Descrição -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/txtNomeAlimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome da Refeição"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescricaoAlimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição do que deve ser comido agora."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Botão de Ação -->
    <Button
        android:id="@+id/btnAlimentar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#007BFF"
        android:textColor="#000000"
        android:text="Alimentar"
        android:textStyle="bold" />

</LinearLayout>

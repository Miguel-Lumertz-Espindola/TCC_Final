<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ranking_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarDiario" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:menu="@menu/diario_menu" app:title="@string/diario_title" app:titleTextColor="@color/ranking_accent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
        <Button android:id="@+id/diaAnterior" android:layout_width="48dp" android:layout_height="48dp" android:text="‹" android:contentDescription="@string/diario_previous" />
        <Button android:id="@+id/dataDiario" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/diaSeguinte" android:layout_width="48dp" android:layout_height="48dp" android:text="›" android:contentDescription="@string/diario_next" />
        <Button android:id="@+id/hojeDiario" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/diario_today" />
    </LinearLayout>
    <Button android:id="@+id/novaRefeicao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:text="@string/diario_new" />
    <LinearLayout android:id="@+id/painelTotais" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_margin="16dp" android:padding="12dp" android:background="@drawable/bg_ranking_row" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/alimentos_total_title" android:textColor="@color/ranking_accent" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/totaisNutrientes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/white" android:textSize="14sp" />
        <TextView android:id="@+id/ajudaTotais" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ranking_text_secondary" android:textSize="12sp" />
        <TextView android:id="@+id/metasDoDia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ranking_accent" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/statusDiario" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:textColor="@color/ranking_text_secondary" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/repetirDiario" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/diario_retry" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/listaDiario" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp" android:clipToPadding="false" />
</LinearLayout>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical">
<ImageView android:id="@+id/iconeDetalheConquista" android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center_horizontal" android:importantForAccessibility="no" />
<TextView android:id="@+id/statusDetalheConquista" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/ranking_accent" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/conquista_how" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" />
<TextView android:id="@+id/criterioDetalheConquista" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ranking_text_secondary" android:textSize="16sp" />
</LinearLayout></ScrollView>
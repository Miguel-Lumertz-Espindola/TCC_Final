<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape android:shape="rectangle">
        <solid android:color="@color/ranking_surface_selected" /><corners android:radius="8dp" />
        <stroke android:width="2dp" android:color="@color/ranking_accent" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="@color/ranking_background" /><corners android:radius="8dp" />
        <stroke android:width="1dp" android:color="@color/ranking_border" />
    </shape></item>
</selector>
